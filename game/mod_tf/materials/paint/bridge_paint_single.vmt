// Bridge textures are black RGB. The paint shape is the alpha, so this
// is a mask: white albedo, detail alpha punches the shape, vertex color tints.
"UnlitGeneric"
{
	"$basetexture"		"vgui/white"
	"$detail"			"paint/bridge_paint_single"
	"$detailblendmode"	"4"
	"$detailblendfactor" "1"
	"$detailscale"		"1"
	"$vertexcolor"		"1"
	"$vertexalpha"		"1"
	"$translucent"		"1"
	"$nocull"			"1"
	"$nofog"			"1"
	"$decal"			"1"
}
