"VertexLitGeneric"
{
	"$basetexture"	"models\weapons\chemist\vial\lubricant"

	$color "[ 246 177 0 ]"

	///////////////////////////////////////////////////////////////////////////////
	//					phong.
	///////////////////////////////////////////////////////////////////////////////
	$phong 1
	$phongboost 0.3	
	$phongexponent 10
	$phongfresnelranges	"[.3 1 8]"

	$rimlight 1
	$rimlightexponent 2
	$rimlightboost 1

	$lightwarptexture "models/player/pyro/pyro_lightwarp"
	$halflambert 0


	///////////////////////////////////////////////////////////////////////////////
	//					paint section.	
	///////////////////////////////////////////////////////////////////////////////
	//$BlendTintByBaseAlpha 1
	//$BlendTintColorOverBase 1.0

	//$colortint_base "[1 1 1]"
	//$colortint_tmp "[0 0 0]"
	//$color2 "{130 90 60}"

	$BaseMapAlphaPhongMask 1	//Needed by SFM to do AO.


	///////////////////////////////////////////////////////////////////////////////
	//					special effects.
	///////////////////////////////////////////////////////////////////////////////
	$cloakPassEnabled 1
	$yellow 0
	$one 1

	//$detail "effects/tiledfire/fireLayeredSlowTiled512.vtf"	
	//$detailscale 5
	//$detailblendfactor 0.01
	//$detailblendmode 6


	///////////////////////////////////////////////////////////////////////////////
	//					Proxies.
	///////////////////////////////////////////////////////////////////////////////
	"Proxies"
	{
		"spy_invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
	}
}

