"VertexLitGeneric"
{
	"$basetexture" "models\player\guard_dog/guard_dog_the_hater_red"
    $selfillum 1
    $selfillummask "models\player\guard_dog/guard_dog_the_hater_selfillum"
	
	//"$bumpmap" "models\player\guard_dog/guard_dog_normal"
	"$basemapalphaphongmask" "0"
	// wrinkle maps need to have $bumpmap enabled to show up
	//"$compress"    "models\player\guard_dog/guard_dog_compress"
	//"$stretch"     "models\player\guard_dog/guard_dog_stretch"

	"$detail" "effects/tiledfire/fireLayeredSlowTiled512.vtf"	
	"$detailscale" "1"
	"$detailblendfactor" .0
	"$detailblendmode" 6
// 	"$bbqamount" "1"	
// 	"$two" "2.35"
// 	"$one" "1"
// 	"$absburnminusone" "1"
// 	"$burnminusone" "1"
// 	"$finalburnlevel" "1"
// 	"$burnlevel" "0"


	"$phong" "1"
	"$phongexponenttexture" "models\player\guard_dog/guard_dog_the_hanger_exponent"
	//"$phongexponent" "25"
	"$phongboost" "4"	
	"$phongalbedotint" "0"
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	
	"$phongfresnelranges"		"[.25 .5 1]"
	"$halflambert" "0"
		// Rim lighting parameters
	"$rimlight" "1"												// To enable rim lighting (requires phong)
	"$rimlightexponent" "4"										// Exponent for phong component of rim lighting	
	"$rimlightboost" "2"										// Boost for ambient cube component of rim lighting
	"$rimmask" "1"                  // Use the alpha channel of the $phongexponenttexture as a rim mask.

	"$ambientocclusion" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$cloakColorTint" "[1 0.5 0.4]"
	"Proxies"
	{
		"spy_invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
	}
}
