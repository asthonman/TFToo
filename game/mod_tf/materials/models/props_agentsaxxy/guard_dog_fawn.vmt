"VertexlitGeneric"
{
	"$basetexture" "models/props_AgentSaxxy/guard_dog_fawn"
	"$bumpmap"     "models/props_AgentSaxxy/guard_dog_normal"

	"$basemapalphaphongmask" "0"

		"$detail" "models/player/shared/noise"
	"$detailscale" "3"
	"$detailblendfactor" "1.5"
	"$detailblendmode" "0"

	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "2"
//	"$lightwarptexture" "models/props_vehicles/pickup_lightwarp"
	"$lightwarptexture"		"models/player/pyro/pyro_lightwarp"

	"$phongfresnelranges"	"[.25 .5 1]"

	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" "1"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"weapon_invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
	}
}
